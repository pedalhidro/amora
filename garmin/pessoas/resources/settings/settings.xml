<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- `share` nasce DESLIGADO: como no amora, ver e transmitir são coisas
         separadas, e pôr o campo numa tela de dados nunca começa a transmitir. -->
    <properties>
        <property id="share" type="boolean">false</property>
        <property id="name" type="string"></property>
        <property id="ttl" type="number">3</property>
        <property id="interval" type="number">15</property>
        <property id="server" type="string">https://amora.pedalhidrografi.co</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.share" title="@Strings.SetShare">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.name" title="@Strings.SetName">
            <settingConfig type="alphaNumeric" maxLength="40" />
        </setting>
        <setting propertyKey="@Properties.ttl" title="@Strings.SetTtl">
            <settingConfig type="numeric" min="1" max="24" />
        </setting>
        <setting propertyKey="@Properties.interval" title="@Strings.SetInterval">
            <settingConfig type="numeric" min="10" max="120" />
        </setting>
        <setting propertyKey="@Properties.server" title="@Strings.SetServer">
            <settingConfig type="url" />
        </setting>
    </settings>
</resources>
