<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- Padrões = DEFAULT_PARAMS do web/app.js do amora (mass, crr, cda, rho,
         kEff, powerFlat, slopeFlatThreshold, deadbandM) + PROFILE_STEP_M.
         Mudou lá, mude aqui e no garmin/tools/kj_parity.mjs. -->
    <properties>
        <property id="budget" type="float">300</property>
        <property id="mass" type="float">75</property>
        <property id="pflat" type="float">50</property>
        <property id="cda" type="float">0.5</property>
        <property id="crr" type="float">0.008</property>
        <property id="rho" type="float">1.1</property>
        <property id="keff" type="float">0.97</property>
        <property id="climbthr" type="float">2</property>
        <property id="deadband" type="float">2</property>
        <property id="step" type="float">30</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.budget" title="@Strings.SetBudget">
            <settingConfig type="numeric" min="0" max="20000" />
        </setting>
        <setting propertyKey="@Properties.mass" title="@Strings.SetMass">
            <settingConfig type="numeric" min="30" max="250" />
        </setting>
        <group id="model" title="@Strings.GroupModel" description="@Strings.GroupModelDesc">
            <setting propertyKey="@Properties.pflat" title="@Strings.SetPFlat">
                <settingConfig type="numeric" min="10" max="500" />
            </setting>
            <setting propertyKey="@Properties.cda" title="@Strings.SetCda">
                <settingConfig type="numeric" />
            </setting>
            <setting propertyKey="@Properties.crr" title="@Strings.SetCrr">
                <settingConfig type="numeric" />
            </setting>
            <setting propertyKey="@Properties.rho" title="@Strings.SetRho">
                <settingConfig type="numeric" />
            </setting>
            <setting propertyKey="@Properties.keff" title="@Strings.SetKeff">
                <settingConfig type="numeric" />
            </setting>
            <setting propertyKey="@Properties.climbthr" title="@Strings.SetClimb">
                <settingConfig type="numeric" min="0" max="20" />
            </setting>
            <setting propertyKey="@Properties.deadband" title="@Strings.SetDeadband">
                <settingConfig type="numeric" min="0" max="20" />
            </setting>
            <setting propertyKey="@Properties.step" title="@Strings.SetStep">
                <settingConfig type="numeric" min="5" max="200" />
            </setting>
        </group>
    </settings>
</resources>
