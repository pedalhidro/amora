         do Forerunner 955). -->
    <iq:application id="41d1da6e5ea24d45965eae4cab6e552a" type="watch-app"
                    name="@Strings.AppName" entry="AmoraApp"
                    launcherIcon="@Drawables.LauncherIcon" minApiLevel="4.0.0">
        <iq:products>
            <iq:product id="edge1040"/>
            <iq:product id="fr955"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
