.env
.DS_Store
node_modules/
*.xlsx
*__pycache__*
backend/pi/data/
venv/
*.pyc

# Runtime state served by the Pi backend — backup target, not source.
web/data/
web/photos/
web/clips/

# Checksums do último sync local<->bucket (scripts/sync-guard.sh) — por
# máquina, não versionado.
.sync-state/
web/tour_assets/
# Fila "enviadas por você" dos apps Garmin (backend/garmin.py) — estado de runtime.
web/garmin_queue.json
# Apps Garmin (Connect IQ): saída do compilador e chave de desenvolvedor.
garmin/*/bin/
garmin/developer_key.*
garmin/tools/out/
sampasimu/
ignore/

# Keystore de assinatura Android (Capacitor) — segredo, nunca versionar.
amora-upload.keystore
